# Cliente a construir (nome da pasta em src/clients)
NEXT_PUBLIC_CLIENT=delta-capital
# URL do webhook que recebe os leads (Make, Zapier, n8n, CRM, ...)
LEAD_WEBHOOK_URL=
# URL público do site (usado em SEO)
NEXT_PUBLIC_SITE_URL=https://deltacapital.vercel.app
# Basic Auth para partilhar o site (vazio = sem proteção)
SITE_USER=delta
SITE_PASSWORD=
# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin (vazio = sem captcha)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Lista de distribuição de leads por email (vários separados por vírgula). Vazio = não envia emails.
LEAD_EMAIL_TO=
# Servidor SMTP que envia os emails (Gmail, Microsoft 365, Brevo, Mailgun, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente (por defeito, SMTP_USER)
LEAD_EMAIL_FROM=
